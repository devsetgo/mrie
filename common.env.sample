# Settings shared by every app on the server, NOT secrets (secrets go in
# Docker secret files - see docker-compose.yml). Copy to
# /opt/docker/shared/common.env on the host. An app's own .env overrides
# anything set here, so an app can still pick a different level.
LOGGING_LEVEL=INFO
LOG_ROTATION=100 MB
LOG_RETENTION=30 days
LOG_BACKTRACE=False
LOG_SERIALIZER=False
LOG_DIAGNOSE=False
DEFAULT_TIMEZONE=America/New_York
