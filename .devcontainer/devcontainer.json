// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "MikeRyan.ie",
	// A plain build, not dockerComposeFile: Compose 5.x builds through
	// `buildx bake`, which refuses to read the features Dockerfile the Dev
	// Containers CLI generates under /tmp (outside the build context) and fails
	// with "additional privileges requested: pass --allow=fs.read=...".
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	// Same layout the compose file used: the parent dir mounted at /workspaces.
	"workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind,consistency=cached",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"runArgs": [
		"--init",
		"--privileged",
		"-v",
		"/var/run/docker.sock:/var/run/docker.sock"
	],
	"forwardPorts": [
		5000,
		32080
	],
	"postCreateCommand": "pip3 install --upgrade pip setuptools wheel && pip3 install -r requirements/dev.txt && sudo chmod 666 /var/run/docker.sock && alembic upgrade head",
	// "postStartCommand": "",
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.formatting.autopep8Path": "/usr/local/py-utils/bin/autopep8",
				"python.formatting.blackPath": "/usr/local/py-utils/bin/black",
				"python.formatting.yapfPath": "/usr/local/py-utils/bin/yapf",
				"python.testing.pytestPath": "/usr/local/py-utils/bin/pytest"
			},
			"extensions": [
				"Anthropic.claude-code",
				"peakchen90.open-html-in-browser",
				"streetsidesoftware.code-spell-checker",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"donjayamanne.githistory",
				"ecmel.vscode-html-css",
				"hnw.vscode-auto-open-markdown-preview",
				"kamikillerto.vscode-colorize",
				"mikestead.dotenv",
				"oderwat.indent-rainbow",
				"wayou.vscode-todo-highlight",
			]
		}
	}
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "vscode"
}