RELEASE_ENV=test
DEBUG_MODE=True
#database configuration
DB_DRIVER=memory
DB_USERNAME=<db-username>
DB_PASSWORD=<db-password>
DB_HOST=<db-host>
DB_PORT=5432
DB_NAME=<db-name>
ECHO=False
FUTURE=True
POOL_PRE_PING=False
POOL_RECYCLE=3600
POOL_SIZE=100
MAX_OVERFLOW=100
POOL_TIMEOUT=3600
# PHRASE/SALT values
PHRASE=<phrase>
SALT=<salt>
#logging configuration
LOGGING_DIRECTORY=logs
LOG_NAME=log
LOGGING_LEVEL=DEBUG
LOG_ROTATION=100 MB
LOG_RETENTION=2 days
LOG_BACKTRACE=False
LOG_SERIALIZER=False
LOG_DIAGNOSE=False
LOG_INTERCEPT_STANDARD_LOGGING=False
# session management
ALLOWED_HOSTS=localhost,domain.com,*.domain.com
# strict, lax, None
SAME_SITE=Strict
SESSION_SECRET_KEY=<key>
HTTPS_ONLY=True
MAX_AGE=7200
# self-hosted Plausible
PLAUSIBLE_DOMAIN=domain.com
PLAUSIBLE_SCRIPT_SRC=https://domain.com/js/script.js
# service accounts
# OpenAI (notes mood/tag/summary analysis, weblinks title/summary)
OPENAI_KEY=<key>
OPENAI_MODEL=gpt-5-nano
# Admin
ADMIN_USER=<your user>
# WebAuthn (passkey login)
WEBAUTHN_RP_ID=domain.com
WEBAUTHN_RP_NAME=mikeryan.ie
WEBAUTHN_ORIGIN=https://domain.com
# required to claim the first-ever passkey; without it, first-time registration
# is closed to everyone. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGISTRATION_BOOTSTRAP_TOKEN=<bootstrap-token>
# Dev-only login bypass (skips WebAuthn entirely) for local testing - only
# ever takes effect when RELEASE_ENV is one of test/dev/local/development
# (see Settings.dev_fake_login_allowed). NEVER set true in production.
DEV_FAKE_LOGIN_ENABLED=False
# history range
HISTORY_RANGE=3
CONVERT_MARKDOWN_TO_HTML=True