RELEASE_ENV=test
DEBUG_MODE=True
#database configuration
# SQLite file at DB_DIRECTORY/DB_NAME.db, schema applied with
# `alembic upgrade head` (the Docker image does this on start). Matches
# production. Set DB_DRIVER=memory instead for a quick, disposable in-memory
# DB (this is what the automated test suite always uses, regardless of this
# file - see tests/conftest.py).
DB_DRIVER=sqlite
DB_DIRECTORY=sqlite_db
DB_NAME=mrie
ECHO=False
FUTURE=True
POOL_RECYCLE=3600
# SQLite per-connection tuning (see src/db_init.py); defaults shown.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_MMAP_SIZE_BYTES=268435456
# PHRASE/SALT values
PHRASE=<phrase>
SALT=<salt>
#logging configuration
LOGGING_DIRECTORY=logs
LOG_NAME=log
LOGGING_LEVEL=DEBUG
LOG_ROTATION=100 MB
LOG_RETENTION=2 days
LOG_BACKTRACE=False
LOG_SERIALIZER=False
LOG_DIAGNOSE=False
LOG_INTERCEPT_STANDARD_LOGGING=False
# session management
# strict, lax, None
SAME_SITE=Strict
SESSION_SECRET_KEY=<key>
HTTPS_ONLY=True
MAX_AGE=7200
SESSION_USER_IDENTIFIER=user_identifier
# self-hosted Plausible
PLAUSIBLE_DOMAIN=domain.com
PLAUSIBLE_SCRIPT_SRC=https://domain.com/js/script.js
# service accounts
DEFAULT_TIMEZONE=America/New_York
# OpenAI (notes mood/tag/summary analysis, weblinks title/summary)
OPENAI_KEY=<key>
OPENAI_MODEL=gpt-5-nano
# Admin
ADMIN_USER=<your user>
# WebAuthn (passkey login)
WEBAUTHN_RP_ID=domain.com
WEBAUTHN_RP_NAME=mikeryan.ie
WEBAUTHN_ORIGIN=https://domain.com
# required to claim the first-ever passkey; without it, first-time registration
# is closed to everyone. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REGISTRATION_BOOTSTRAP_TOKEN=<bootstrap-token>
# Dev-only login bypass (skips WebAuthn entirely) for local testing - only
# ever takes effect when RELEASE_ENV is one of test/dev/local/development
# (see Settings.dev_fake_login_allowed). NEVER set true in production.
DEV_FAKE_LOGIN_ENABLED=False
# history range
HISTORY_RANGE=3