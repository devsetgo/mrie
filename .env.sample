# Local development settings: copy to .env and fill in the <placeholders>.
# Documents every setting the app reads (src/settings.py). For production use
# deploy/.env.pre-prd instead - several values below differ there.

# --- Environment ------------------------------------------------------------
# A dev value (test/dev/local/development) enables demo data seeding, the
# heapdump endpoint and the fake-login bypass. Anything else is production
# (the default is prd, so a typo fails closed).
RELEASE_ENV=dev
DEBUG_MODE=True
# Dev-only login bypass (skips WebAuthn entirely) - only takes effect when
# RELEASE_ENV is a dev value (see Settings.dev_fake_login_allowed). Pinned
# to False in deploy/docker-compose.yml.
DEV_FAKE_LOGIN_ENABLED=False

# --- Database ---------------------------------------------------------------
# SQLite file at DB_DIRECTORY/DB_NAME.db, schema applied with
# `alembic upgrade head` (the Docker image does this on start). Matches
# production. Set DB_DRIVER=memory instead for a quick, disposable in-memory
# DB (this is what the automated test suite always uses, regardless of this
# file - see tests/conftest.py).
DB_DRIVER=sqlite
DB_DIRECTORY=sqlite_db
DB_NAME=mrie
# Logs every SQL statement with its parameters - debugging only.
ECHO=False
FUTURE=True
POOL_RECYCLE=3600
# SQLite per-connection tuning (see src/db_init.py); defaults shown.
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_CACHE_SIZE_KIB=65536
SQLITE_MMAP_SIZE_BYTES=268435456

# --- Encryption -------------------------------------------------------------
# Derive the key that encrypts every note; must match the values the notes
# were encrypted with. In production these (and OPENAI_KEY) are Docker
# secrets mounted at /run/secrets - see deploy/docker-compose.yml.
PHRASE=<phrase>
SALT=<salt>

# --- Logging ----------------------------------------------------------------
LOGGING_DIRECTORY=logs
LOG_NAME=log
LOGGING_LEVEL=DEBUG
LOG_ROTATION=100 MB
LOG_RETENTION=2 days
LOG_BACKTRACE=False
LOG_SERIALIZER=False
LOG_DIAGNOSE=False
LOG_INTERCEPT_STANDARD_LOGGING=False

# --- Session cookie ---------------------------------------------------------
# Optional in dev (a random key per process), required in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=<key>
# True breaks login over plain http://localhost (Secure cookie) - see CLAUDE.md.
HTTPS_ONLY=False
# Strict, Lax or None
SAME_SITE=Strict
MAX_AGE=7200
SESSION_USER_IDENTIFIER=user_identifier

# --- Login (passkeys) -------------------------------------------------------
# The single identity allowed to register and log in.
ADMIN_USER=<your user>
# Must match how the browser reaches the app exactly (not 127.0.0.1).
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5000
WEBAUTHN_RP_NAME=mikeryan.ie
# Required to claim the first-ever passkey; without it, first-time
# registration is closed to everyone.
REGISTRATION_BOOTSTRAP_TOKEN=<bootstrap-token>

# --- AI (notes mood/tag/summary analysis, weblinks title/summary) ----------
OPENAI_KEY=<key>
OPENAI_MODEL=gpt-5-nano

# --- Analytics (self-hosted Plausible); empty script src disables it -------
PLAUSIBLE_DOMAIN=mikeryan.ie
PLAUSIBLE_SCRIPT_SRC=

# --- App --------------------------------------------------------------------
# "On this day" window: notes this many days either side of today, past years.
HISTORY_RANGE=3
DEFAULT_TIMEZONE=America/New_York

# --- Other ------------------------------------------------------------------
# Directory pydantic-settings reads Docker secret files from (env var only,
# not .env). Default /run/secrets; ignored when it doesn't exist.
# SECRETS_DIR=/run/secrets
