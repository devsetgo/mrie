# =============================================================================
# mikeryan.ie - PRODUCTION .env template
# =============================================================================
# On the server, next to docker-compose.yml:
#     cp .env.pre-prd .env && chmod 600 .env
# then replace every  __FILL_ME__  value below. The app refuses to start
# while any value is still __FILL_ME__; a wrong ADMIN_USER or WEBAUTHN_*
# value only shows up when you try to log in.
#
# What does NOT go in this file:
#   - PHRASE, SALT, OPENAI_KEY: Docker secret files under
#     /opt/docker/shared/secrets/ (see docker-compose.yml). Never add them
#     here too: a .env value wins over the secret file.
#   - RELEASE_ENV, DEV_FAKE_LOGIN_ENABLED, HTTPS_ONLY, DB_DRIVER,
#     DB_DIRECTORY, LOGGING_DIRECTORY: pinned in docker-compose.yml;
#     values here are ignored.
#   - Shared logging/timezone defaults: /opt/docker/shared/common.env
#     (see common.env.sample). Uncomment one below only to override it.
#
# Generate a random value with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- Session cookie ---------------------------------------------------------
# REQUIRED, at least 32 characters (the app refuses to start otherwise).
# Signs the session cookie; every uvicorn worker must share it. Changing it
# logs you out, nothing else.
SESSION_SECRET_KEY=__FILL_ME__
# Strict, Lax or None. Strict: arriving from a link on another site shows
# you logged out until the next click.
SAME_SITE=Strict
# Session lifetime in seconds (7200 = 2 hours).
MAX_AGE=7200

# --- Login (passkeys) -------------------------------------------------------
# REQUIRED. The single identity allowed to register and log in.
ADMIN_USER=__FILL_ME__
# Must match the URL in the browser exactly - the bare domain, no www
# (Traefik redirects www to it), no trailing slash.
WEBAUTHN_RP_ID=mikeryan.ie
WEBAUTHN_ORIGIN=https://mikeryan.ie
WEBAUTHN_RP_NAME=mikeryan.ie
# Needed only to register the FIRST passkey on a new database. Once any
# passkey exists, registration is closed to logged-out visitors regardless;
# blank this afterwards anyway (then `docker compose up -d`).
REGISTRATION_BOOTSTRAP_TOKEN=__FILL_ME__

# --- AI ---------------------------------------------------------------------
# The key itself is the openai_key Docker secret. Without it the site still
# works; notes and links are just not analysed.
OPENAI_MODEL=gpt-5-nano

# --- Analytics (self-hosted Plausible) --------------------------------------
PLAUSIBLE_DOMAIN=mikeryan.ie
# Full URL of your Plausible script. Leave empty to disable analytics.
PLAUSIBLE_SCRIPT_SRC=https://plausible.devsetgo.com/js/script.js

# --- App --------------------------------------------------------------------
DEBUG_MODE=False
# "On this day" window on the notes pages: notes from this many days either
# side of today's date, in past years.
HISTORY_RANGE=3

# --- Database ---------------------------------------------------------------
# File is /app/sqlite_db/<DB_NAME>.db on the mrie-db volume. Changing this
# points the app at a new, empty database.
DB_NAME=mrie
ECHO=False

# --- Overrides of /opt/docker/shared/common.env (optional) ------------------
# LOGGING_LEVEL=INFO
# LOG_RETENTION=30 days
# DEFAULT_TIMEZONE=America/New_York
